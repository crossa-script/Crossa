config {
    baseUrl: "http://127.0.0.1:18765",
    timeoutRequest: 5000,
    commonHeaders: {
        "X-Common": "crossa"
    },
    interceptor: {
        enabled: true,
        logRequests: true,
        logResponses: true
    },
    workerThreads: 2,
    maxQueuedTasks: 16,
    maxResponseBytes: 1048576,
    maxJsonDepth: 32,
    followRedirects: false
}
