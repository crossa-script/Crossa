model Post(
    userId: Int,
    id: Int,
    title: String,
    body: String
)

@AsyncAfter
fun getPost(): Post {
    re CrossaRequest {
        url: "/posts/1",
        method: GET,
        headers: {
            "X-Crossa-Request": "get"
        },
        customHeaders: {
            "X-Crossa-Custom": "enabled"
        },
        queryParams: {
            page: 1
        },
        timeout: 1000
    }
}

@AsyncAfter
fun listPosts(): List<Post> {
    re CrossaRequest {
        url: "/posts",
        method: GET
    }
}

@AsyncAfter
fun createPost(): Json {
    re CrossaRequest {
        url: "/posts",
        method: POST,
        body: {
            "title": "local",
            "body": "mock",
            "userId": 1
        }
    }
}

getPost()
listPosts()
createPost()
assert(true, "local CrossaRequest integration passed")
