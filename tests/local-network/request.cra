model Post(
    userId: Int,
    id: Int,
    title: String,
    body: String
)

@AsyncAfter
fun getPost(): Post {
    re CrossaRequest {
        url: "/posts/1",
        method: GET,
        headers: {
            "X-Crossa-Request": "get",
            "Authorization": "secret-token"
        },
        customHeaders: {
            "X-Crossa-Custom": "enabled"
        },
        queryParams: {
            page: 1
        },
        timeout: 1000,
        retryPolicy: {
            maxAttempts: 1
        },
        uploadProgress: true,
        downloadStreaming: true,
        coalesce: true,
        proxy: {},
        certificatePolicy: {
            verifyPeer: true,
            verifyHost: true
        },
        telemetry: {
            enabled: true,
            serviceName: "request-test"
        }
    }
}

@AsyncAfter
fun listPosts(): List<Post> {
    re CrossaRequest {
        url: "/posts",
        method: GET
    }
}

@AsyncAfter
fun createPost(): Json {
    re CrossaRequest {
        url: "/posts",
        method: POST,
        body: {
            "title": "local",
            "body": "mock",
            "userId": 1
        }
    }
}

@AsyncAfter
fun getAuthenticated(): Json {
    re CrossaRequest {
        url: "/auth",
        method: GET,
        auth: "api",
        uploadProgress: true,
        downloadStreaming: true
    }
}

@AsyncAfter
fun uploadMultipart(): Json {
    re CrossaRequest {
        url: "/multipart",
        method: POST,
        multipart: {
            parts: [
                {name: "description", data: "native"},
                {name: "payload", data: "crossa"}
            ]
        },
        uploadProgress: true,
        telemetry: {
            enabled: true,
            serviceName: "multipart-test"
        }
    }
}

getPost()
listPosts()
createPost()
getAuthenticated()
uploadMultipart()
assert(true, "local CrossaRequest integration passed")
